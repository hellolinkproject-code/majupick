{
  "name": "@workbridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../../.env src/server.js",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:test": "node scripts/migrate-test-db.js",
    "db:check": "node --env-file-if-exists=../../.env scripts/check-db.js",
    "test:scripts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tests/db-scripts.tests.ps1",
    "pretest:db": "prisma generate",
    "test:db": "vitest run --config vitest.db.config.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
