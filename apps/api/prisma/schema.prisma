// WorkBridge Prisma schema — planning/ERD_v1.md 기준 (STEP 03-B 9개 테이블 + 이후 단계 추가분)
// - 금액은 bigint(원), 상한 없음. API에서는 10진수 문자열로 직렬화한다(D-51, D-42).
// - 시각은 timestamptz(UTC 저장), 모집 날짜는 date(KST 날짜)다(D-41, D-58).
// - Prisma로 표현할 수 없는 CHECK 제약은 마이그레이션 SQL에 직접 추가했다.
// - DB 연결 URL은 이 파일이 아니라 prisma.config.js에서 읽는다.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// enums
// ---------------------------------------------------------------------------

enum UserRole {
  CLIENT
  FREELANCER

  @@map("user_role")
}

enum OAuthProvider {
  GOOGLE

  @@map("oauth_provider")
}

enum OAuthTransactionKind {
  LOGIN
  LINK

  @@map("oauth_transaction_kind")
}

/// 7개 상태(D-03). 화면의 한국어 이름은 프론트엔드에서 매핑한다.
enum ProjectStatus {
  SCHEDULED
  RECRUITING
  CLOSED
  CONTRACTING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("project_status")
}

/// 지원 결과(RFP 3.2.4). 화면의 한국어 이름(검토중·수락·거절)은 프론트엔드에서 매핑한다.
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("application_status")
}

/// 거절 사유(D-49, 제안). status = REJECTED일 때만 값이 있다(CHECK).
enum RejectReason {
  MANUAL
  OTHER_ACCEPTED
  PROJECT_CLOSED
  NEGOTIATION_FAILED
  PROJECT_CANCELLED
  PROJECT_DELETED

  @@map("reject_reason")
}

/// 의뢰인 합의 금액 제안 상태(D-11·D-118). 선정(ACCEPTED)과 별개로, 제안 API로만 채워진다.
enum OfferStatus {
  PENDING
  AGREED
  DECLINED

  @@map("offer_status")
}

/// 계약 세부 상태(D-04). 프로젝트 상태와 분리. SIGNED 이전은 체결 완료가 아니다(D-13).
enum ContractStatus {
  SIGNATURE_PENDING
  SIGNED
  IN_PROGRESS
  DELIVERY_REQUESTED
  COMPLETED
  CANCELLED

  @@map("contract_status")
}

/// 결제 상태(D-04, D-17). PAID만 계약당 1건(부분 UNIQUE).
enum PaymentStatus {
  READY
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

/// 모의 에스크로 보관·지급(D-17). 실제 금융 에스크로가 아니다(D-123).
enum EscrowStatus {
  HELD
  RELEASED

  @@map("escrow_status")
}

/// RFP 3.3.1 필수 알림 5종(ERD §3.12)
enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_ACCEPTED
  APPLICATION_AUTO_REJECTED
  APPLICATION_REJECTED
  PROJECT_CLOSED

  @@map("notification_type")
}

/// 제안(D-59)
enum ProjectCategory {
  WEB
  MOBILE
  DESIGN
  MARKETING
  DATA_AI
  PLANNING
  ETC

  @@map("project_category")
}

/// 제안(D-59)
enum BusinessField {
  IT
  COMMERCE
  EDUCATION
  FINANCE
  HEALTHCARE
  MEDIA
  MANUFACTURING
  ETC

  @@map("business_field")
}

// ---------------------------------------------------------------------------
// 사용자·인증
// ---------------------------------------------------------------------------

model User {
  id              Int       @id @default(autoincrement())
  /// 저장 전 소문자·공백 제거 정규화
  email           String    @unique @db.VarChar(255)
  /// bcrypt 해시. 소셜로만 가입한 계정은 NULL
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  name            String    @db.VarChar(50)
  /// 소셜 최초 로그인 직후만 NULL
  role            UserRole?
  profileImageUrl String?   @map("profile_image_url") @db.VarChar(500)
  bio             String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientProfile     ClientProfile?
  freelancerProfile FreelancerProfile?
  socialAccounts    SocialAccount[]
  refreshTokens     RefreshToken[]
  oauthTransactions OAuthTransaction[]
  projects          Project[]
  applications      Application[]
  createdTechStacks TechStack[]
  notifications     Notification[]
  bookmarks         Bookmark[]
  aiUsageLedgers    AiUsageLedger[]
  clientContracts     Contract[] @relation("ContractClient")
  freelancerContracts Contract[] @relation("ContractFreelancer")
  payments            Payment[]

  @@map("users")
}

model SocialAccount {
  id             Int           @id @default(autoincrement())
  userId         Int           @map("user_id")
  provider       OAuthProvider
  /// Google `sub`
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  /// 연동 시점에 제공자가 인증 완료로 확인한 이메일
  emailAtLink    String        @map("email_at_link") @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("social_accounts")
}

/// Google 로그인 진행(LOGIN)과 기존 계정 연결 확인(LINK).
/// 쿠키 원문 대신 SHA-256 해시만 저장하고, 검증에 성공하면 행을 지운다(일회용).
model OAuthTransaction {
  id             Int                  @id @default(autoincrement())
  kind           OAuthTransactionKind
  tokenHash      String               @unique @map("token_hash") @db.Char(64)
  /// PKCE verifier. LOGIN 동안만 서버에 있고 URL·로그에 남기지 않는다.
  codeVerifier   String?              @map("code_verifier") @db.VarChar(255)
  nonce          String?              @db.VarChar(255)
  returnTo       String?              @map("return_to") @db.VarChar(500)
  providerUserId String?              @map("provider_user_id") @db.VarChar(255)
  email          String?              @db.VarChar(255)
  userId         Int?                 @map("user_id")
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_transactions")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  /// SHA-256 해시(hex 64자). 원문은 저장하지 않는다
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// 역할별 프로필 (완성 여부는 서비스 함수가 판정, D-05 미확정)
// ---------------------------------------------------------------------------

model ClientProfile {
  userId           Int            @id @map("user_id")
  companyName      String?        @map("company_name") @db.VarChar(100)
  businessField    BusinessField? @map("business_field")
  /// business_field = 'ETC'일 때만 값 허용(CHECK)
  businessFieldEtc String?        @map("business_field_etc") @db.VarChar(100)
  websiteUrl       String?        @map("website_url") @db.VarChar(500)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model FreelancerProfile {
  userId       Int              @id @map("user_id")
  mainCategory ProjectCategory? @map("main_category")
  /// CHECK >= 0
  careerYears  Int?             @map("career_years")
  /// 시간당 단가(원). CHECK > 0, 상한 없음
  hourlyRate   BigInt?          @map("hourly_rate")
  portfolioUrl String?          @map("portfolio_url") @db.VarChar(500)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  techStacks FreelancerTechStack[]

  @@map("freelancer_profiles")
}

// ---------------------------------------------------------------------------
// 기술 스택
// ---------------------------------------------------------------------------

model TechStack {
  id             Int      @id @default(autoincrement())
  /// 표시 이름(예: React)
  name           String   @db.VarChar(50)
  /// 소문자 + 공백·점·하이픈 제거(예: node.js → nodejs)
  normalizedName String   @unique @map("normalized_name") @db.VarChar(50)
  isCustom       Boolean  @default(false) @map("is_custom")
  createdById    Int?     @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy   User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  projects    ProjectTechStack[]
  freelancers FreelancerTechStack[]

  @@map("tech_stacks")
}

model FreelancerTechStack {
  freelancerId Int @map("freelancer_id")
  techStackId  Int @map("tech_stack_id")

  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [userId], onDelete: Cascade)
  techStack  TechStack         @relation(fields: [techStackId], references: [id], onDelete: Restrict)

  @@id([freelancerId, techStackId])
  @@index([techStackId])
  @@map("freelancer_tech_stacks")
}

model ProjectTechStack {
  projectId   Int @map("project_id")
  techStackId Int @map("tech_stack_id")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  techStack TechStack @relation(fields: [techStackId], references: [id], onDelete: Restrict)

  @@id([projectId, techStackId])
  @@index([techStackId])
  @@map("project_tech_stacks")
}

// ---------------------------------------------------------------------------
// 프로젝트
// ---------------------------------------------------------------------------

model Project {
  id               Int             @id @default(autoincrement())
  clientId         Int             @map("client_id")
  title            String          @db.VarChar(100)
  description      String
  category         ProjectCategory
  /// KST 날짜. NULL이면 등록 즉시 모집 중
  recruitStartDate DateTime?       @map("recruit_start_date") @db.Date
  /// KST 날짜. 그날 23:59:59(KST)까지 모집
  recruitEndDate   DateTime        @map("recruit_end_date") @db.Date
  /// 원. CHECK > 0, 상한 없음
  budget           BigInt
  status           ProjectStatus
  closedAt         DateTime?       @map("closed_at") @db.Timestamptz(3)
  cancelledAt      DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  /// 소프트 삭제
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(3)
  /// 등록 요청 키(Idempotency-Key). 같은 의뢰인이 같은 키로 다시 보내면 새로 만들지 않는다
  idempotencyKey   String?         @map("idempotency_key") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  client        User               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  techStacks    ProjectTechStack[]
  applications  Application[]
  notifications Notification[]
  bookmarks     Bookmark[]
  contract      Contract?

  @@unique([clientId, idempotencyKey])
  @@index([status, recruitEndDate], map: "projects_status_recruit_end_date_active_idx", where: raw("deleted_at IS NULL"))
  @@index([status, recruitStartDate], map: "projects_status_recruit_start_date_active_idx", where: raw("deleted_at IS NULL"))
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([budget(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// 지원 (STEP 06-A·06-B) + 합의 금액 제안(STEP 09-A, ERD_v1 §3.8).
// 선정(ACCEPTED)과 금액 제안(offer_*)은 서로 다른 이벤트다(D-118).
// ---------------------------------------------------------------------------

model Application {
  id                   Int               @id @default(autoincrement())
  projectId            Int               @map("project_id")
  /// 인증된 프리랜서 본인(요청 본문으로 받지 않는다)
  freelancerId         Int               @map("freelancer_id")
  /// 자기소개
  coverLetter          String            @map("cover_letter")
  /// 예상 단가(원). CHECK > 0, 상한 없음. 의뢰인 합의 제안(offer_amount)과 별개다.
  proposedAmount       BigInt            @map("proposed_amount")
  /// 예상 기간(일, D-46). CHECK > 0
  proposedDurationDays Int               @map("proposed_duration_days")
  status               ApplicationStatus @default(PENDING)
  /// status = REJECTED일 때만 값(CHECK)
  rejectReason         RejectReason?     @map("reject_reason")
  /// 수락·거절 시각. status <> PENDING일 때만 값(CHECK)
  decidedAt            DateTime?         @map("decided_at") @db.Timestamptz(3)
  /// 의뢰인이 제시한 합의 금액(원). 제안 API로만 채운다(D-118). CHECK > 0
  offerAmount          BigInt?           @map("offer_amount")
  offerStatus          OfferStatus?      @map("offer_status")
  offeredAt            DateTime?         @map("offered_at") @db.Timestamptz(3)
  offerRespondedAt     DateTime?         @map("offer_responded_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  freelancer    User           @relation(fields: [freelancerId], references: [id], onDelete: Restrict)
  notifications Notification[]
  contract      Contract?

  @@unique([projectId, freelancerId])
  /// 프로젝트당 선정(ACCEPTED) 1건(A-33). 수락 트랜잭션의 행 잠금이 뚫려도 DB가 막는다
  @@unique([projectId], map: "applications_one_accepted_per_project", where: raw("status = 'ACCEPTED'"))
  @@index([projectId, status])
  @@index([freelancerId, createdAt(sort: Desc)])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// 계약 (STEP 09-A, ERD_v1 §3.9). 금액 동의 시 생성. 전자서명·결제는 이후 단계.
// ---------------------------------------------------------------------------

model Contract {
  id                   Int            @id @default(autoincrement())
  projectId            Int            @unique @map("project_id")
  applicationId        Int            @unique @map("application_id")
  clientId             Int            @map("client_id")
  freelancerId         Int            @map("freelancer_id")
  /// 생성 시점 프로젝트명 스냅샷
  projectTitle         String         @map("project_title") @db.VarChar(100)
  /// 서버가 applications.offer_amount에서 복사(B-06). CHECK > 0
  agreedAmount         BigInt         @map("agreed_amount")
  /// 지원서 예상 기간 복사(D-14). CHECK > 0
  durationDays         Int            @map("duration_days")
  /// 자동 생성 계약 본문
  terms                String
  /// 생성 시점 양측·프로젝트 핵심 정보(D-15)
  partiesSnapshot      Json           @map("parties_snapshot")
  status               ContractStatus @default(SIGNATURE_PENDING)
  clientSignedAt       DateTime?      @map("client_signed_at") @db.Timestamptz(3)
  freelancerSignedAt   DateTime?      @map("freelancer_signed_at") @db.Timestamptz(3)
  /// 양측 서명 완료 = 계약 체결(D-13). 결제·IN_PROGRESS와는 분리한다.
  signedAt             DateTime?      @map("signed_at") @db.Timestamptz(3)
  workStartedAt        DateTime?      @map("work_started_at") @db.Timestamptz(3)
  deliveryNote         String?        @map("delivery_note")
  deliveryUrl          String?        @map("delivery_url") @db.VarChar(500)
  deliveryRequestedAt  DateTime?      @map("delivery_requested_at") @db.Timestamptz(3)
  completedAt          DateTime?      @map("completed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  client     User        @relation("ContractClient", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer User        @relation("ContractFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([freelancerId, createdAt(sort: Desc)])
  @@map("contracts")
}

// ---------------------------------------------------------------------------
// 결제 (STEP 10-A, ERD_v1 §3.10). 토스페이먼츠 테스트/Fake PG. 실결제·환불·지급 없음.
// ---------------------------------------------------------------------------

model Payment {
  id           Int           @id @default(autoincrement())
  contractId   Int           @map("contract_id")
  payerId      Int           @map("payer_id")
  /// 서버 생성 주문 번호. PG·승인 검증에 사용
  orderId      String        @unique @map("order_id") @db.VarChar(64)
  /// PG paymentKey. 승인 후에만 채움. UNIQUE(NULL 허용)
  paymentKey   String?       @unique @map("payment_key") @db.VarChar(200)
  /// contracts.agreed_amount 복사. CHECK > 0
  amount       BigInt
  status       PaymentStatus @default(READY)
  /// PG 응답 결제 수단(카드 등). 카드번호는 저장하지 않는다
  method       String?       @db.VarChar(30)
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz(3)
  failCode     String?       @map("fail_code") @db.VarChar(80)
  failReason   String?       @map("fail_reason") @db.VarChar(500)
  /// 모의 에스크로. PAID 시 HELD. RELEASED는 정산(STEP 10-B)
  escrowStatus EscrowStatus? @map("escrow_status")
  feeAmount    BigInt?       @map("fee_amount")
  payoutAmount BigInt?       @map("payout_amount")
  releasedAt   DateTime?     @map("released_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  payer    User     @relation(fields: [payerId], references: [id], onDelete: Restrict)

  /// 계약당 결제 성공 1건(B-09)
  @@unique([contractId], map: "payments_one_paid_per_contract", where: raw("status = 'PAID'"))
  /// 계약당 READY 주문 1건(동시 결제 시작)
  @@unique([contractId], map: "payments_one_ready_per_contract", where: raw("status = 'READY'"))
  @@index([payerId, createdAt(sort: Desc)])
  @@index([contractId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// 인앱 알림 (STEP 06-C, RFP 3.3.1의 5종). 제목·문구는 발생 시점의 스냅샷이라
// 이후 프로젝트 상태가 바뀌어도 의미가 유지된다. 지원 내용·연락처는 담지 않는다.
// ---------------------------------------------------------------------------

model Notification {
  id            Int              @id @default(autoincrement())
  /// 받는 사람
  userId        Int              @map("user_id")
  type          NotificationType
  projectId     Int?             @map("project_id")
  applicationId Int?             @map("application_id")
  title         String           @db.VarChar(100)
  message       String           @db.VarChar(255)
  /// 서비스 내부 경로만(CHECK). 외부 URL은 저장하지 않는다
  linkUrl       String           @map("link_url") @db.VarChar(255)
  /// 같은 이벤트의 중복 생성을 막는 키(예: APPLICATION_SUBMITTED:application:12)
  eventKey      String           @unique @map("event_key") @db.VarChar(120)
  readAt        DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId], map: "notifications_user_id_unread_idx", where: raw("read_at IS NULL"))
  @@index([projectId])
  @@index([applicationId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// 북마크 (STEP 07-A, RFP 3.4.1). 프리랜서가 저장한 프로젝트. 프로젝트는 소프트 삭제만 하므로
// 삭제·취소된 프로젝트의 행도 남겨 두고, 조회할 때 공개 범위로 거른다(ERD_v1 §3.13, §7.9).
// ---------------------------------------------------------------------------

model Bookmark {
  userId    Int      @map("user_id")
  projectId Int      @map("project_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([userId, createdAt(sort: Desc), projectId(sort: Desc)])
  @@index([projectId])
  @@map("bookmarks")
}

// ---------------------------------------------------------------------------
// AI 사용량·월간 예산 예약 (STEP 08-B-1). 견적 결과 본문은 저장하지 않는다(D-27).
// 금액은 micro-USD(1 USD = 1_000_000) bigint로 보관한다(D-117).
// ---------------------------------------------------------------------------

enum AiUsageStatus {
  RESERVED
  SETTLED
  /// 타임아웃 등 과금 불확실 — 예약을 환불하지 않음
  FAILED_CHARGED
  /// 호출 전·과금 없음이 확실한 실패 — 예약 환불
  RELEASED

  @@map("ai_usage_status")
}

/// 월(UTC YYYY-MM)별 약정(예약+확정+불확실) 합. FOR UPDATE로 동시 예약을 직렬화한다.
model AiBudgetMonth {
  monthKey          String   @id @map("month_key") @db.Char(7)
  committedMicroUsd BigInt   @default(0) @map("committed_micro_usd")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_budget_months")
}

model AiUsageLedger {
  id                BigInt        @id @default(autoincrement())
  userId            Int           @map("user_id")
  monthKey          String        @map("month_key") @db.Char(7)
  status            AiUsageStatus
  provider          String        @db.VarChar(32)
  model             String        @db.VarChar(64)
  reservedMicroUsd  BigInt        @map("reserved_micro_usd")
  settledMicroUsd   BigInt?       @map("settled_micro_usd")
  inputTokens       Int?          @map("input_tokens")
  outputTokens      Int?          @map("output_tokens")
  providerRequestId String?       @map("provider_request_id") @db.VarChar(128)
  errorCode         String?       @map("error_code") @db.VarChar(64)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  settledAt         DateTime?     @map("settled_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([monthKey, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status], map: "ai_usage_ledger_reserved_idx", where: raw("status = 'RESERVED'"))
  @@map("ai_usage_ledger")
}
