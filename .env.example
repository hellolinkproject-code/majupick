# WorkBridge 환경 변수 예시
# 이 파일을 복사해 프로젝트 루트에 .env를 만든다. .env는 Git에 커밋하지 않는다.
# 백엔드(apps/api)와 프론트엔드(apps/web) 모두 루트의 .env를 읽는다.
# 프론트엔드에는 VITE_ 로 시작하는 변수만 노출된다. 비밀 값에 VITE_ 접두어를 붙이지 않는다.

# ---- 백엔드 ----
NODE_ENV=development
API_PORT=4000
# 허용할 프론트엔드 출처(쉼표로 여러 개)
CORS_ORIGIN=http://localhost:5173

# ---- 프론트엔드 ----
# 비워 두면 /api 로 요청하고, 개발 서버가 API_PORT로 프록시한다
VITE_API_BASE_URL=

# ---- 다음 단계에서 사용 (STEP 03-B 이후, 지금은 비워 둔다) ----
# DATABASE_URL=postgresql://workbridge:change-me@localhost:5432/workbridge_dev
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# OPENAI_API_KEY=
