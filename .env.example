# WorkBridge 환경 변수 예시
# 이 파일을 복사해 프로젝트 루트에 .env를 만든다. .env는 Git에 커밋하지 않는다.
# 백엔드(apps/api), Prisma CLI, 프론트엔드(apps/web) 모두 루트의 .env를 읽는다.
# 프론트엔드에는 VITE_ 로 시작하는 변수만 노출된다. 비밀 값에 VITE_ 접두어를 붙이지 않는다.

# ---- 백엔드 ----
NODE_ENV=development
API_PORT=4000
# 허용할 프론트엔드 출처(쉼표로 여러 개)
CORS_ORIGIN=http://localhost:5173

# ---- 데이터베이스 (로컬 PostgreSQL) ----
# apps/api/scripts/setup-local-db.ps1 을 실행하면 아래 3개 값이 실제 비밀번호와 함께 자동으로 채워진다.
# 세 URL은 반드시 서로 다른 DB를 가리켜야 한다(개발 / 테스트 / Prisma shadow).
#   DATABASE_URL        개발 서버·prisma migrate deploy (DB 이름이 _test, _shadow로 끝나면 거부)
#   TEST_DATABASE_URL   npm run test:db, npm run db:migrate:test 전용 (DB 이름이 _test로 끝나야 함)
#   SHADOW_DATABASE_URL 마이그레이션 생성(migrate dev --create-only) 때 Prisma가 비우고 다시 쓰는 DB (_shadow로 끝나야 함)
# 비밀번호에 특수문자가 있으면 URL 인코딩해야 한다(setup-local-db.ps1이 자동 처리).
# 로컬(localhost) 이외의 DB는 ALLOW_REMOTE_DATABASE=true 일 때만 연결된다.
DATABASE_URL=postgresql://workbridge_app:<password>@localhost:5432/workbridge_dev
TEST_DATABASE_URL=postgresql://workbridge_app:<password>@localhost:5432/workbridge_test
SHADOW_DATABASE_URL=postgresql://workbridge_app:<password>@localhost:5432/workbridge_shadow
ALLOW_REMOTE_DATABASE=false

# ---- 인증 (이메일 로그인, JWT) ----
# Access Token 서명 키. 32자 이상 무작위 문자열. 운영(NODE_ENV=production)에서는 필수.
# 생성 예: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# 개발에서 비워 두면 서버가 실행마다 임시 키를 만든다(재시작하면 Access Token만 무효, 자동 재발급됨).
JWT_ACCESS_SECRET=
# 아래는 비워 두면 기본값을 쓴다(근거: planning/DECISIONS.md D-64~D-68).
# Access Token 유효 시간(초, 기본 900 = 15분)
ACCESS_TOKEN_TTL_SECONDS=
# Refresh Token 유효 기간(일, 기본 14)
REFRESH_TOKEN_TTL_DAYS=
# bcrypt 라운드(기본 12, 운영 최소 10)
BCRYPT_ROUNDS=
# Refresh Token 쿠키에 Secure를 붙일지(true/false). 운영에서는 항상 Secure. 로컬 HTTPS 테스트에서만 true로 둔다
COOKIE_SECURE=
# IP당 15분 동안 허용하는 로그인 실패 횟수(기본 10)
LOGIN_RATE_LIMIT_MAX=

# ---- 프론트엔드 ----
# 비워 두면 /api 로 요청하고, 개발 서버가 API_PORT로 프록시한다
VITE_API_BASE_URL=

# ---- Google 로그인 (STEP 04-B) ----
# 세 값을 모두 비우면 Google 로그인을 끄고, 화면은 설정 안내를 보여 준다.
# 일부만 채우면 서버가 시작하지 않는다. Client Secret은 이 파일에 실제 값을 적지 않는다.
# Redirect URI는 프론트 출처 + /api/auth/oauth/google/callback 이어야 한다.
# 로컬은 Vite가 /api 를 API로 프록시하므로 브라우저는 localhost:5173 에 머문다.
# Google Cloud 설정 순서는 README의 "Google Cloud 설정"을 본다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/oauth/google/callback

# ---- 프로필 이미지 (STEP 04-B-2) ----
# 업로드 이미지를 저장할 로컬 폴더(그 아래 profile-images/ 사용). 비우면 apps/api/uploads.
# 상대 경로는 apps/api 기준. 이 폴더는 Git에 올리지 않는다.
# 운영 영구 저장소(Supabase Storage 등)는 비용 확인·승인 후 연결한다(planning/DECISIONS.md D-76).
UPLOAD_DIR=

# ---- 모집 자동 마감 (STEP 06-C) ----
# API 서버가 시작할 때 1번, 이후 이 간격(밀리초)마다 모집 상태를 동기화한다(기본 60000 = 1분).
# 0이면 서버 안의 주기 실행을 끄고, 외부 스케줄러가 npm run job:sync-project-status -w apps/api 를 부르게 한다.
# 허용 범위: 0 또는 5000~86400000. 자세한 내용은 README의 "모집 자동 마감".
RECRUIT_SYNC_INTERVAL_MS=

# ---- 다음 단계에서 사용 (지금은 비워 둔다) ----
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# OPENAI_API_KEY=
